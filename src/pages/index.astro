---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Experience from '../components/Experience.astro';
import Markets from '../components/Markets.astro';
import Clients from '../components/Clients.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import FloatActions from '../components/FloatActions.astro';
import { offices, site } from '../data/site';

const head = offices.head;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  description: 'Full load truck transportation across India since 1965.',
  url: Astro.site?.href,
  foundingDate: String(site.founded),
  telephone: head.phones.map((p) => p.display),
  email: head.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: head.address[0],
    addressLocality: 'Deesa',
    addressRegion: 'Gujarat',
    postalCode: '385535',
    addressCountry: 'IN',
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      opens: '08:00',
      closes: '20:30',
    },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '09:00', closes: '18:00' },
  ],
};
---

<Layout title={`${site.name} | Full Load Transport Since ${site.founded}`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <a class="skip-link" href="#main">Skip to content</a>
  <Header />
  <main id="main">
    <Hero />
    <Experience />
    <Markets />
    <Clients />
    <Contact />
  </main>
  <Footer />
  <FloatActions />
</Layout>
